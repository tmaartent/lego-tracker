# Copy to .env and fill in. Get a free key at https://rebrickable.com/api/
REBRICKABLE_API_KEY=
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
# Leave unset to use SQLite locally; docker-compose sets it to PostgreSQL.
# DATABASE_URL=postgres://lego:lego@localhost:5432/core
# Only needed to run the outbox relay outside docker-compose.
# RABBITMQ_URL=amqp://guest:guest@localhost:5672/%2F

# Telegram for the notifier. Without both, notifications are only logged.
# Create a bot with @BotFather, send it a message, then find your chat id with:
#   docker compose exec notifier python -m notifier.find_chat_id
NOTIFIER_TELEGRAM_BOT_TOKEN=
NOTIFIER_TELEGRAM_CHAT_ID=

# eBay for the watcher: production keys (App ID and Cert ID) from
# https://developer.ebay.com/my/keys. Then add ebay to the sources.
WATCHER_EBAY_CLIENT_ID=
WATCHER_EBAY_CLIENT_SECRET=
# WATCHER_SOURCES=["fake","ebay"]
# Only sellers in Belgium; leave out for anyone who ships here.
# WATCHER_EBAY_SELLER_COUNTRY=BE
